# Copiar este archivo como .env y completar. En Vercel se carga en
# Project Settings > Environment Variables.

# Endpoint de Formspree para el formulario de contacto (formspree.io > New form).
# Si no esta definido, el formulario muestra el mensaje de error y deriva a WhatsApp.
VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
